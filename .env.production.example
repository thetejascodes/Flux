# Copy to ".env" ON THE SERVER ONLY (compose reads it automatically).
# Never commit the real file. Make sure ".env" is in .gitignore.
#
# Generate each secret with:  openssl rand -hex 16
# Use hex on purpose: these end up inside connection URLs, and characters
# like @ : / # would break them.

DOMAIN=flux.yourdomain.com

POSTGRES_PASSWORD=change-me
RABBITMQ_USER=flux
RABBITMQ_PASSWORD=change-me
