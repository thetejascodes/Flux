# Gateway environment template
# Copy this file to .env and replace placeholder values before running the app.

PORT=4000
DATABASE_URL=postgresql://admin:admin@localhost:5432/flux

# Generate real JWT keys and base64-encode the PEM content before using them.
# Example:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# base64 private.pem
# base64 public.pem
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_ENCODED_PRIVATE_KEY
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_ENCODED_PUBLIC_KEY
JWT_ACCESS_EXPIRES_IN=15m

# Twilio OTP settings (leave blank if using stub mode)
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# Google OAuth settings (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Set to true to disable real OTP sending during local development
OTP_STUB_MODE=true
